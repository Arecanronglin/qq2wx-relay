# 统一换行符，避免 Windows / Linux 混用把脚本搞坏
* text=auto

# Windows 批处理必须是 CRLF，否则 cmd 解析会出问题
*.bat text eol=crlf
*.cmd text eol=crlf

# shell 脚本和 git hook 必须是 LF
*.sh text eol=lf
.githooks/* text eol=lf

# 二进制，别乱动
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.zstd binary
